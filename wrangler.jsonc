{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "atmospheric-builders-retreat",
	"account_id": "78d122b6d8bffc90a65a4a468608afeb",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		// The public URL — also the ATProto OAuth client_id base; must match
		// exactly where the app is served.
		"ORIGIN": "https://buildersretre.at",
		// Respond-by deadline: Aug 15 2026, 11:59:59 PM Pacific (PDT = UTC-7).
		"DEADLINE": "2026-08-16T06:59:59Z",
		// Registration deadline: Sep 20 2026, 11:59:59 PM Pacific (PDT = UTC-7).
		// Extended from Sep 7 on 2026-09-13 so the announcement can go out.
		// After this, no NEW confirmations; edits and declines stay open.
		"REG_DEADLINE": "2026-09-21T06:59:59Z",
		// DIDs allowed into /organizer (comma-separated).
		// Bryan (@chaosgreml.in), Alex (@alex.bsky.team).
		"ORGANIZER_DIDS": "did:plc:h3wpawnrlptr4534chevddo6,did:plc:vmt7o7y6titkqzzxav247zrn",
		// Email sending via comail.at (HTTP Send API). The DID is the comail
		// account identity (Bryan's — already public in ORGANIZER_DIDS).
		"EMAIL_FROM": "hello@buildersretre.at",
		"COMAIL_DID": "did:plc:h3wpawnrlptr4534chevddo6"
	},
	"kv_namespaces": [
		{ "binding": "OAUTH_SESSIONS", "id": "b54ff92b5d6c4d53bf6126663f0e5077" },
		{ "binding": "OAUTH_STATES", "id": "53f60970b28d49cab0ef8f3586c57d1b" },
		{ "binding": "PROFILE_CACHE", "id": "64cc6bb2682f448fa8f52696bbca9bd4" }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "buildtreat",
			"database_id": "979ba4c1-f2ba-492f-965e-b2c179564093",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		// Retreat-site photos. Private — no public bucket URL; the Worker
		// serves them at /media/site/[id] after a visibility check.
		{ "binding": "SITE_MEDIA", "bucket_name": "buildtreat-site-media" }
	]
	// Secrets (wrangler secret put): COOKIE_SECRET, CLIENT_ASSERTION_KEY, COMAIL_API_KEY,
	// BSKY_DM_HANDLE + BSKY_DM_APP_PASSWORD (organizer DM broadcasts; optional BSKY_DM_PDS
	// var if the sending account isn't on bsky.social)
}
